{
  "name": "@proofwork/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "link:code": "tsx scripts/link-code.ts",
    "github:backfill": "tsx scripts/github-backfill.ts"
  },
  "dependencies": {
    "@proofwork/crypto": "workspace:*",
    "fflate": "0.8.3",
    "grammy": "1.46.0",
    "viem": "2.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.7.0",
    "tsx": "4.19.0",
    "typescript": "5.6.2",
    "vitest": "^5.1.0"
  }
}
