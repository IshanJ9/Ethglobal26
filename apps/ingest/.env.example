# apps/ingest: Telegram bot + GitHub webhook. Copy to apps/ingest/.env (gitignored) and fill in.
API_BASE_URL=http://localhost:8787
WEB_BASE_URL=http://localhost:3000
CONNECTOR_KEY=demo-connector-key-change-me      # must equal CONNECTOR_KEY in apps/api/.env
LINK_SECRET=change-me-to-32-random-chars-xxxxxxxx  # signs /start link codes

TELEGRAM_BOT_TOKEN=                # from @BotFather; empty = bot disabled
TELEGRAM_BOT_USERNAME=             # without @, for t.me deep links

GITHUB_WEBHOOK_SECRET=             # same value as the repo webhook secret; empty = webhook disabled
GITHUB_TOKEN=                      # read-only token for the backfill script (optional for public repos)
GITHUB_REPO=                       # owner/name of the demo repo
GITHUB_LOGIN_MAP=                  # login=employee_id pairs, e.g. asha-dev=emp_dev_a,ben-dev=emp_dev_b

INGEST_PORT=8788
INGEST_CYCLE_ID=cyc_2026h2
COSIGNER_ADDRESS=0xDD0F57c26b23999240Fd524Ee43a4f918BbA7415   # seed p_client_cfo
COSIGNER_LABEL=Client CFO, Acme Bank
