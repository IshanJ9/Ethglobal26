{
  "name": "@proofwork/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "keys:gen": "tsx scripts/gen-keys.ts",
    "seed:reset": "tsx scripts/seed-reset.ts",
    "e2e:demo": "node -e \"console.error('e2e:demo arrives in Block 2');process.exit(1)\"",
    "e2e:chain": "node -e \"console.error('e2e:chain arrives in Block 2');process.exit(1)\""
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@proofwork/crypto": "workspace:*",
    "@proofwork/shared": "workspace:*",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pino": "^10.4.0",
    "viem": "2.21.0",
    "yaml": "2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.7.0",
    "tsx": "4.19.0",
    "typescript": "5.6.2",
    "vitest": "^5.1.0"
  }
}
