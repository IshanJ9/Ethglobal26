{
  "name": "proofwork",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "spec:check": "tsx scripts/spec-check.mjs",
    "test:crypto": "pnpm --filter @proofwork/crypto test",
    "gen:fixtures": "tsx scripts/gen-fixtures.mjs",
    "spec:build": "node scripts/compile-abi.mjs && python3 spec/vectors/generate.py && pnpm gen:fixtures && pnpm gen:types",
    "spec:abi": "node scripts/check-abi.mjs",
    "gen:types": "openapi-typescript spec/openapi.yaml -o packages/shared/src/api.d.ts",
    "mock:api": "prism mock spec/openapi.yaml -p 8787 -d --cors",
    "check:abi": "node scripts/check-abi-all.mjs",
    "dev": "pnpm -r --parallel --if-present dev",
    "e2e:demo": "pnpm --filter @proofwork/api e2e:demo",
    "e2e:chain": "pnpm --filter @proofwork/api e2e:chain"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.12.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.4.1",
    "solc": "0.8.26",
    "tsx": "4.19.0",
    "yaml": "2.6.0"
  }
}
